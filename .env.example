# ============================================================
# ELIO — variáveis de ambiente (copie para .env.local e preencha)
# NUNCA commite o .env.local nem exponha chaves *_SECRET/*_KEY no front.
# ============================================================

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MIN_AGE=14

# ---- Supabase (painel do projeto → Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
# ATENÇÃO: service_role só no servidor (rotas /api e scripts). Jamais no cliente.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# ---- Segurança / limites (por janela de 1 minuto, salvo indicação) ----
RATE_LOGIN_PER_MIN=10
RATE_REGISTER_PER_MIN=5
RATE_MESSAGE_PER_MIN=60
RATE_RPC_PER_MIN=120

# ---- Uploads ----
MAX_UPLOAD_MB=25
MAX_AVATAR_MB=5
MAX_WALLPAPER_MB=8

# ---- Feature flags (Fase 1: tudo avançado desligado) ----
FEATURE_CALLS=false
FEATURE_ELIO_IA=false
FEATURE_COMMUNITIES=false
FEATURE_GROUPS=false
FEATURE_VOICE=false
FEATURE_FILES=false

# ---- Push (Fase 4; gere com: npx web-push generate-vapid-keys) ----
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:voce@exemplo.com
# CRON_SECRET=troque-por-um-segredo-forte

# ---- IA (Fase 5) ----
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# AI_MODEL=gemini-2.5-flash
# AI_DAILY_LIMIT=30

# ---- Chamadas TURN (Fase 6) ----
# NEXT_PUBLIC_STUN_URLS=stun:stun.l.google.com:19302
# TURN_URL=
# TURN_USERNAME=
# TURN_CREDENTIAL=
